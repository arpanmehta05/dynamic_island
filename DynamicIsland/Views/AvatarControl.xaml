<UserControl x:Class="DynamicIsland.Views.AvatarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Alive, but barely: a slow bob and a blink every few seconds, at a low frame rate -->
        <Storyboard x:Key="Alive" Timeline.DesiredFrameRate="15">
            <DoubleAnimation Storyboard.TargetName="Bob" Storyboard.TargetProperty="Y" From="1" To="-1.5" Duration="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Blink" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.4" Value="0.12"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.55" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.9" Value="0.12"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.05" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:7" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <!-- The island's own face (the same character as the app icon): a soft violet blob with big eyes -->
    <Viewbox>
        <Canvas Width="64" Height="64">
            <Canvas.RenderTransform><TranslateTransform x:Name="Bob"/></Canvas.RenderTransform>
            <Ellipse Width="60" Height="60" Canvas.Left="2" Canvas.Top="2">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                        <GradientStop Color="#A6C4FF" Offset="0"/>
                        <GradientStop Color="#9A8CFF" Offset="0.55"/>
                        <GradientStop Color="#C07CFF" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="34" Height="20" Canvas.Left="10" Canvas.Top="5" Opacity="0.35">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="10" Height="6" Canvas.Left="7" Canvas.Top="37" Fill="#FF8DB5" Opacity="0.7"/>
            <Ellipse Width="10" Height="6" Canvas.Left="47" Canvas.Top="37" Fill="#FF8DB5" Opacity="0.7"/>
            <Canvas Width="64" Height="64" RenderTransformOrigin="0.5,0.47">
                <Canvas.RenderTransform><ScaleTransform x:Name="Blink"/></Canvas.RenderTransform>
                <Ellipse Width="13" Height="18" Canvas.Left="16" Canvas.Top="21" Fill="White"/>
                <Ellipse Width="13" Height="18" Canvas.Left="35" Canvas.Top="21" Fill="White"/>
                <Ellipse Width="8" Height="11" Canvas.Left="19.5" Canvas.Top="26" Fill="#1C1830"/>
                <Ellipse Width="8" Height="11" Canvas.Left="38.5" Canvas.Top="26" Fill="#1C1830"/>
                <Ellipse Width="3.2" Height="3.2" Canvas.Left="21" Canvas.Top="27.5" Fill="White"/>
                <Ellipse Width="3.2" Height="3.2" Canvas.Left="40" Canvas.Top="27.5" Fill="White"/>
            </Canvas>
            <Path Data="M 26.5,43.5 Q 32,49 37.5,43.5" Stroke="#2B2452" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>
</UserControl>
