<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DynamicIsland.Views"
        Title="Dynamic Island Settings" Width="900" Height="700" MinWidth="740" MinHeight="520"
        Background="Transparent" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <FontFamily x:Key="Inter">/Fonts/#Inter</FontFamily>
        <FontFamily x:Key="InterSemiBold">/Fonts/#Inter SemiBold</FontFamily>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="Card" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="CardEdge" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#8B7CFF"/>
        <SolidColorBrush x:Key="Dim" Color="#A8A8BC"/>
        <CubicEase x:Key="Smooth" EasingMode="EaseOut"/>

        <!-- Sidebar entry: a quiet row that fills when it is the chosen section -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B4B4C6"/>
            <Setter Property="FontFamily" Value="{StaticResource InterSemiBold}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Height="40" Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="10" Background="White" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" Margin="14,0">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Width="26"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.05"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.10"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On / off switch driven by SettingItem.IsOn (the Button's Tag follows it) -->
        <Style x:Key="Switch" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" CornerRadius="13" Background="#40FFFFFF"/>
                            <Border x:Name="Knob" Width="20" Height="20" CornerRadius="10" Background="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.RenderTransform><TranslateTransform x:Name="Slide"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Track" Property="Background" Value="#8B7CFF"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.22" EasingFunction="{StaticResource Smooth}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource Smooth}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A choice shown as a card (the glass looks): a sample on top, name and description below; the chosen one has an accent edge -->
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Edge" CornerRadius="16" Background="{StaticResource Card}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1.5"/>
                            <ContentPresenter Margin="14"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#4DFFFFFF"/></Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="#8B7CFF"/>
                                <Setter TargetName="Edge" Property="Background" Value="#2A8B7CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource InterSemiBold}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="#26FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="16,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Our own scrollbar: a thin rounded thumb floating over the content; it brightens and thickens under the pointer -->
        <Style x:Key="InvisibleRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GlassThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar" Width="5" CornerRadius="2.5" Background="White" Opacity="0.3" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="Grow"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.5" Duration="0:0:0.2" EasingFunction="{StaticResource Smooth}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.25"/>
                                    <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource Smooth}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="0.85"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource InvisibleRepeat}"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource InvisibleRepeat}"/></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource GlassThumb}"/></Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource GlassScrollBar}" HorizontalAlignment="Right" Margin="0,8,4,8"
                                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource InterSemiBold}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#7A15151D" Offset="0"/><GradientStop Color="#940D0D14" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <!-- the same diagonal sheen the island has -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#16FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.4"/><GradientStop Color="#00FFFFFF" Offset="0.75"/><GradientStop Color="#0AFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Sidebar -->
        <Border Background="#40000000" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
            <Grid Margin="16,22,16,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="6,0,0,26">
                    <views:AvatarControl Width="38" Height="38"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Dynamic Island" Foreground="White" FontFamily="{StaticResource InterSemiBold}" FontSize="14.5"/>
                        <TextBlock Text="Settings" Foreground="{StaticResource Dim}" FontFamily="{StaticResource Inter}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Tag="&#xE790;" Content="Appearance" IsChecked="True" GroupName="nav"/>
                    <RadioButton x:Name="NavTabs" Style="{StaticResource NavItem}" Tag="&#xE71D;" Content="Buttons" GroupName="nav"/>
                    <RadioButton x:Name="NavBehavior" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Behavior" GroupName="nav"/>
                    <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavItem}" Tag="&#xE765;" Content="Shortcuts" GroupName="nav"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About" GroupName="nav"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Changes apply straight away" Foreground="#6C6C80" FontFamily="{StaticResource Inter}" FontSize="11.5" Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- Content: one panel per section -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0" Background="Transparent">
            <Grid Margin="44,40,44,32" MaxWidth="720" HorizontalAlignment="Left">

                <!-- Appearance -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=NavAppearance, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="How the glass of the island looks. The island changes while you choose." Style="{StaticResource SectionNote}"/>
                    <ItemsControl ItemsSource="{Binding GlassChoices}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChoiceCard}" Command="{Binding Flip}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <!-- a sample: the island's time over a colourful picture, under the glass this card stands for -->
                                        <Grid Height="76">
                                            <Border CornerRadius="12">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#6A4CFF" Offset="0"/><GradientStop Color="#FF5FA2" Offset="0.5"/><GradientStop Color="#FF9A4C" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Width="132" Height="34" CornerRadius="17" BorderBrush="#40FFFFFF" BorderThickness="1">
                                                <Border.Background><SolidColorBrush Color="#12121A" Opacity="{Binding Preview}"/></Border.Background>
                                                <TextBlock Text="10:25 AM" Foreground="White" FontFamily="{StaticResource InterSemiBold}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontFamily="{StaticResource InterSemiBold}" FontSize="14" Margin="0,12,0,0"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Dim}" FontFamily="{StaticResource Inter}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=NavTabs, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Buttons" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Which buttons the island shows in its footer. An assistant's button still only appears while that app is open or busy." Style="{StaticResource SectionNote}"/>
                    <ItemsControl ItemsSource="{Binding TabItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="40" VerticalAlignment="Center">
                                            <Border CornerRadius="12" Background="{Binding Tab.Accent}" Opacity="0.22"/>
                                            <TextBlock Text="{Binding Tab.Glyph}" FontFamily="{Binding Tab.GlyphFont}" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding Tab.ShowGlyph, Converter={StaticResource BoolToVis}}"/>
                                            <Image Source="{Binding Tab.Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Path Data="{Binding Tab.Logo}" Fill="White" Stretch="Uniform" Width="19" Height="19"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontFamily="{StaticResource InterSemiBold}" FontSize="14"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Dim}" FontFamily="{StaticResource Inter}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Switch}" Command="{Binding Flip}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Behavior -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=NavBehavior, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Behavior" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="When the island is out of the way and when it is in it." Style="{StaticResource SectionNote}"/>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding AutoHide.Name}" Foreground="White" FontFamily="{StaticResource InterSemiBold}" FontSize="14"/>
                                <TextBlock Text="{Binding AutoHide.Description}" Foreground="{StaticResource Dim}" FontFamily="{StaticResource Inter}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Switch}" Command="{Binding Flip}" DataContext="{Binding AutoHide}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="14" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="Always on top, always on screen" Foreground="White" FontFamily="{StaticResource InterSemiBold}" FontSize="14"/>
                            <TextBlock Text="The island is brought back above other windows whenever you switch windows, change displays, unlock or wake the PC. It only steps aside for the screen-capture toolbar (Print Screen, Win+Shift+S)." Foreground="{StaticResource Dim}" FontFamily="{StaticResource Inter}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Shortcuts -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=NavShortcuts, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Keys that work from any program." Style="{StaticResource SectionNote}"/>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="14" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Open the island" Foreground="White" FontFamily="{StaticResource InterSemiBold}" FontSize="14"/>
                                <TextBlock Text="Opens it for a few seconds without the mouse; press it again to close it" Foreground="{StaticResource Dim}" FontFamily="{StaticResource Inter}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PillButton}" Command="{Binding ChangeHotkey}">
                                <TextBlock FontFamily="{StaticResource InterSemiBold}" FontSize="12.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding HotkeyText}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsCapturing}" Value="True"><Setter Property="Text" Value="Press the new shortcut..."/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Message}" Foreground="#FFB454" FontFamily="{StaticResource Inter}" FontSize="12.5" Margin="4,12,0,0"/>
                </StackPanel>

                <!-- About -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=NavAbout, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="A small glass island for the top of your Windows desktop." Style="{StaticResource SectionNote}"/>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="14" Padding="22">
                        <StackPanel Orientation="Horizontal">
                            <views:AvatarControl Width="64" Height="64"/>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Dynamic Island" Foreground="White" FontFamily="{StaticResource InterSemiBold}" FontSize="18"/>
                                <TextBlock Foreground="{StaticResource Dim}" FontFamily="{StaticResource Inter}" FontSize="12.5" Margin="0,3,0,0">
                                    <Run Text="Version "/><Run Text="{Binding Version, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="C# · .NET 8 · WPF" Foreground="{StaticResource Dim}" FontFamily="{StaticResource Inter}" FontSize="12.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Open these settings any time from the island's icon in the system tray (it may sit under the ^ arrow), or from the Start menu." Foreground="{StaticResource Dim}" FontFamily="{StaticResource Inter}" FontSize="12.5" TextWrapping="Wrap" Margin="4,16,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
